<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.czf</groupId>
    <artifactId>czf-ai-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>czf-ai-agent</name>
    <description>czf-ai-agent</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <!-- ============================================================
         dependencies（依赖区）
         下面按「用途」分成几个区块，每块前都有说明。
         Maven 会根据这些坐标自动从仓库下载对应 jar 包。
         ============================================================ -->
    <dependencies>

        <!-- ========== 1. Web 框架核心 ========== -->
        <!-- Spring Boot Web MVC：构建 Web 应用 / HTTP 接口的基础包，
             内置 Tomcat 服务器和 Spring MVC，是所有接口的起点。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ========== 2. 开发工具类库 ========== -->
        <!-- Lombok：编译期工具，用 @Data/@Getter 等注解自动生成
             getter/setter/构造方法，减少样板代码。
             <optional>true</optional> 表示仅编译期辅助，不传递给其他模块。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
            <optional>true</optional>
        </dependency>

        <!-- Hutool：国产 Java 工具集，封装日期/字符串/文件/加密/JSON 等常用方法，
             让我们少写重复代码。 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.37</version>
        </dependency>

        <!-- ========== 3. AI 大模型 SDK ========== -->
        <!-- 阿里云百炼（DashScope）Java SDK：用于调用通义千问等大模型能力。
             坐标来自 https://mvnrepository.com/artifact/com.alibaba/dashscope-sdk-java -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <version>2.19.1</version>
        </dependency>

        <!-- ========== 4. 接口文档 ========== -->
        <!-- Knife4j：基于 OpenAPI3 的接口文档工具，启动后访问 /doc.html
             即可看到可视化、可调试的中文 API 文档，方便前后端联调。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>

        <!-- ========== 5. 测试 ========== -->
        <!-- Web MVC 测试起步包：写接口自动化测试用，<scope>test</scope>
             表示只在测试阶段生效，不会打进最终运行包。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ============================================================
         build（构建区）
         配置项目如何被编译、打包，以及使用哪些 Maven 插件。
         ============================================================ -->
    <build>
        <plugins>
            <!-- Spring Boot 打包插件：把项目连同所有依赖打包成可直接运行的 jar/可执行文件。
                 excludes 里把 lombok 排除，避免把它打进最终运行包（它只需编译期）。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 编译插件：声明 Lombok 为「注解处理器」路径，
                 这样编译时才能识别 @Data/@Getter 等注解并生成代码。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
