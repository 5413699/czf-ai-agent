# Leave empty in local development to use Vite's /api proxy.
# Set this to the backend origin (for example, https://api.example.com) in deployment.
VITE_API_BASE_URL=

# Use "mock" for standalone frontend development and "api" for the Spring Boot service.
VITE_CUSTOMER_SUPPORT_MODE=mock

# Optional origin for immutable static assets (leave empty for local assets).
VITE_ASSET_CDN_URL=

# Generate production source maps only when explicitly enabled.
VITE_SOURCEMAP=false
